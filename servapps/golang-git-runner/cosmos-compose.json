{
  "cosmos-installer": {
    "form": [
      {
        "name": "GIT_REPOSITORY_URL",
        "label": "Git Repository URL (HTTPS)",
        "initialValue": "",
        "type": "text"
      },
      {
        "name": "GIT_BRANCH",
        "label": "Git Branch",
        "initialValue": "main",
        "type": "text"
      },
      {
        "name": "GITHUB_TOKEN",
        "label": "GitHub Personal Access Token (for private repos)",
        "initialValue": "",
        "type": "password"
      },
      {
        "name": "INSTALL_CMD",
        "label": "Module Download Command",
        "initialValue": "go mod download",
        "type": "text"
      },
      {
        "name": "BUILD_CMD",
        "label": "Build Command",
        "initialValue": "go build -o /app/bin/server .",
        "type": "text"
      },
      {
        "name": "START_CMD",
        "label": "Start Command",
        "initialValue": "/app/bin/server",
        "type": "text"
      },
      {
        "name": "APP_PORT",
        "label": "Application HTTP Port",
        "initialValue": "8080",
        "type": "text"
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "golang:1.24-alpine",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "working_dir": "/app",
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}"
      },
      "environment": [
        "CGO_ENABLED=0",
        "GIT_REPOSITORY_URL={GIT_REPOSITORY_URL}",
        "GIT_BRANCH={GIT_BRANCH}",
        "GITHUB_TOKEN={GITHUB_TOKEN}",
        "INSTALL_CMD={INSTALL_CMD}",
        "BUILD_CMD={BUILD_CMD}",
        "START_CMD={START_CMD}",
        "APP_PORT={APP_PORT}",
        "PORT={APP_PORT}"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-app",
          "target": "/app",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-pkg",
          "target": "/go/pkg/mod",
          "type": "volume"
        }
      ],
      "command": "sh -c echo$IFS\"\"|base64$IFS-d|sh",
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Rota principal HTTP do ServApp Go",
          "useHost": true,
          "target": "http://{ServiceName}:8080",
          "mode": "SERVAPP",
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
