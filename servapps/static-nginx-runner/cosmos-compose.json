{
  "cosmos-installer": {
    "form": [
      {
        "name": "GIT_REPOSITORY_URL",
        "label": "Git Repository URL (HTTPS)",
        "initialValue": "",
        "type": "text"
      },
      {
        "name": "GIT_BRANCH",
        "label": "Git Branch",
        "initialValue": "main",
        "type": "text"
      },
      {
        "name": "GITHUB_TOKEN",
        "label": "GitHub Personal Access Token (for private repos)",
        "initialValue": "",
        "type": "password"
      },
      {
        "name": "DIST_DIR",
        "label": "Build Output Directory (e.g. dist, build, public)",
        "initialValue": "dist",
        "type": "text"
      },
      {
        "name": "INSTALL_CMD",
        "label": "Install Command",
        "initialValue": "npm install",
        "type": "text"
      },
      {
        "name": "BUILD_CMD",
        "label": "Build Command",
        "initialValue": "npm run build",
        "type": "text"
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "leopersan/static-nginx-runner:latest",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "working_dir": "/app",
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}",
        "cosmos-persistent-env": "GIT_REPOSITORY_URL, GIT_BRANCH, GITHUB_TOKEN, DIST_DIR, INSTALL_CMD, BUILD_CMD"
      },
      "environment": [
        "GIT_REPOSITORY_URL={Context.GIT_REPOSITORY_URL}",
        "GIT_BRANCH={Context.GIT_BRANCH}",
        "GITHUB_TOKEN={Context.GITHUB_TOKEN}",
        "DIST_DIR={Context.DIST_DIR}",
        "INSTALL_CMD={Context.INSTALL_CMD}",
        "BUILD_CMD={Context.BUILD_CMD}",
        "APP_PORT=80",
        "PORT=80"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-app",
          "target": "/app",
          "type": "volume"
        },
        {
          "source": "{ServiceName}-nginx-html",
          "target": "/usr/share/nginx/html",
          "type": "volume"
        }
      ],
      "routes": [
        {
          "name": "{ServiceName}",
          "description": "Rota principal HTTP do ServApp Nginx Estático / SPA",
          "useHost": true,
          "target": "http://{ServiceName}:80",
          "mode": "SERVAPP",
          "SmartShield": {
            "Enabled": true
          }
        }
      ]
    }
  }
}
