{
  "cosmos-installer": {
    "form": [
      {
        "name": "MYSQL_ROOT_PASSWORD",
        "label": "Root Password",
        "initialValue": "",
        "type": "password"
      },
      {
        "name": "MYSQL_DATABASE",
        "label": "Initial Database Name",
        "initialValue": "app_db",
        "type": "text"
      },
      {
        "name": "MYSQL_USER",
        "label": "Initial User Name",
        "initialValue": "app_user",
        "type": "text"
      },
      {
        "name": "MYSQL_PASSWORD",
        "label": "Initial User Password",
        "initialValue": "app_secret",
        "type": "password"
      },
      {
        "name": "ADDITIONAL_DATABASES",
        "label": "Additional Databases (comma-separated)",
        "initialValue": "",
        "type": "text"
      },
      {
        "name": "ADDITIONAL_USERS",
        "label": "Additional Users (user:pass:db, comma-separated)",
        "initialValue": "",
        "type": "text"
      }
    ]
  },
  "minVersion": "0.8.0",
  "services": {
    "{ServiceName}": {
      "image": "mysql:8.4",
      "container_name": "{ServiceName}",
      "restart": "unless-stopped",
      "labels": {
        "cosmos-force-network-secured": "true",
        "cosmos-auto-update": "true",
        "cosmos-stack": "{ServiceName}",
        "cosmos-stack-main": "{ServiceName}",
        "cosmos-persistent-env": "MYSQL_ROOT_PASSWORD, MYSQL_DATABASE, MYSQL_USER, MYSQL_PASSWORD, ADDITIONAL_DATABASES, ADDITIONAL_USERS"
      },
      "environment": [
        "MYSQL_ROOT_PASSWORD={Context.MYSQL_ROOT_PASSWORD}",
        "MYSQL_DATABASE={Context.MYSQL_DATABASE}",
        "MYSQL_USER={Context.MYSQL_USER}",
        "MYSQL_PASSWORD={Context.MYSQL_PASSWORD}",
        "ADDITIONAL_DATABASES={Context.ADDITIONAL_DATABASES}",
        "ADDITIONAL_USERS={Context.ADDITIONAL_USERS}",
        "APP_PORT=3306",
        "PORT=3306"
      ],
      "volumes": [
        {
          "source": "{ServiceName}-data",
          "target": "/var/lib/mysql",
          "type": "volume"
        }
      ],
      "command": "sh -c echo$IFS\"\"|base64$IFS-d|sh"
    }
  }
}